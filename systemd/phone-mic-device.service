[Unit]
Description=Phone Mic — virtual microphone device (PipeWire loopback)
After=pipewire.service pipewire-pulse.service wireplumber.service
Requires=pipewire.service
PartOf=pipewire.service

[Service]
# Creates two nodes:
#   phone_mic_in  a plain input *stream* (NOT a device, so it never shows up under Output in Settings).
#                 autoconnect=false: nothing gets linked to it except the phone-mic-daemon stream that targets it by name.
#   phone_mic     the input device "Phone Mic" that apps record from. High priority: when no input was picked by
#                 hand (fresh login, the picked one vanished) WirePlumber chooses Phone Mic over built-in/jack mics.
ExecStart=/usr/bin/pw-loopback --name phone-mic --channels 1 --channel-map '[ MONO ]' \
  --capture-props='node.name=phone_mic_in node.description="Phone Mic feed" node.autoconnect=false audio.position=[MONO]' \
  --playback-props='media.class=Audio/Source node.name=phone_mic node.description="Phone Mic" priority.session=3000 priority.driver=3000 audio.position=[MONO]'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
