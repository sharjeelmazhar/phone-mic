#!/usr/bin/env bash
# phone-mic — small control command for the phone-as-microphone setup.
#   phone-mic on | off | toggle | enable | disable | state | status | pair | phones | forget <phone> | app | log | test
#             | default | doctor | kdeconnect [add|remove] | setup | uninstall | version

VERSION=2.1.2
UNITS="phone-mic-device.service phone-mic.service"
UUID=phone-mic@sharjeelmazhar.github.io
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/phone-mic"
DONE="$CONF_DIR/setup-done"       # written by `setup`: this user has been set up (so it is not repeated at every login)
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/phone-mic"     # state file and pairing request of phone-mic-daemon
APP_URL=https://sharjeelmazhar.github.io/phone-mic/PhoneMic.apk
# Two layouts: the .deb (/usr/bin/phone-mic + helpers in /usr/lib/phone-mic) or install.sh (everything in ~/.local/bin).
ME="$(readlink -f "$0")"; LIB="$(dirname "$ME")"; PACKAGED=0
[ -f "$LIB/phone-mic-daemon" ] || { LIB=/usr/lib/phone-mic; PACKAGED=1; }
notify() { command -v notify-send >/dev/null && notify-send -i audio-input-microphone "Phone Mic" "$1"; echo "$1"; }

# A copy put into the home folder by install.sh would shadow the packaged one (its units and its tile win over
# the system ones). Take it away; config, paired phones and the autostart choice are kept.
drop_home_copy() {
    [ -e ~/.local/bin/phone-mic ] || [ -e ~/.config/systemd/user/phone-mic.service ] || return 1
    systemctl --user disable $UNITS >/dev/null 2>&1          # only the autostart links; what is running keeps running
    rm -f ~/.config/systemd/user/adb-server.service ~/.config/systemd/user/phone-mic.service ~/.config/systemd/user/phone-mic-device.service
    rm -f ~/.local/bin/phone-mic ~/.local/bin/phone-mic-daemon ~/.local/bin/phone-mic-stream ~/.local/bin/phone-mic-gsconnect.js
    rm -f ~/.local/share/applications/phone-mic-toggle.desktop
    rm -rf ~/.local/share/gnome-shell/extensions/$UUID
    return 0
}

# Version 1 streamed with scrcpy over adb and ran its own adb server (adb-server.service). That unit is gone:
# stop it, remove its autostart link and the phone address file. adb itself and the phone's settings are left alone.
drop_v1() {
    systemctl --user stop adb-server.service 2>/dev/null
    rm -f ~/.config/systemd/user/default.target.wants/adb-server.service ~/.config/systemd/user/adb-server.service "$CONF_DIR/phone-addr"
}

# What keeps the mic from ever working on this computer (printed by `status` and `setup`)
problems() {
    command -v pw-cat >/dev/null || echo "PROBLEM: pw-cat is missing (package pipewire-bin)."
    pactl info 2>/dev/null | grep -q "PulseAudio (on PipeWire" ||
        echo "PROBLEM: the audio server does not look like PipeWire; the virtual microphone needs PipeWire with pipewire-pulse and WirePlumber."
}

# The daemon's state: off | waiting | pairing <code> <phone> | streaming <phone>   (phone names are %-encoded)
state_line() {
    case "$(systemctl --user show phone-mic.service -p ActiveState --value 2>/dev/null)" in
        active|activating|reloading) ;;     # "activating" = about to be restarted (3 s gap after a failure): not "off"
        *) echo off; return ;;
    esac
    local s; s=$(cat "$RUN_DIR/state" 2>/dev/null); echo "${s:-waiting}"
}
decode() { python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "$1"; }
paired() { grep -q '"key"' "$CONF_DIR/phones.json" 2>/dev/null; }

app_help() {
    echo "The phone needs the Phone Mic app (no developer options, no cable). Open this link on the phone:"
    echo "  $APP_URL"
    if command -v qrencode >/dev/null; then qrencode -t ANSIUTF8 -m 1 "$APP_URL"; else echo "  (with the qrencode package installed, a QR code to scan is shown here)"; fi
    echo "Install and open it, allow the microphone, then pair: run 'phone-mic pair' and scan its QR code in the app."
    echo "(The first phone also pairs by itself: compare the 6-digit code on both and tap Allow on the phone.)"
}

# Take the tile out of one of GNOME's extension lists (enabled-extensions / disabled-extensions)
unlist() {
    local cur new; cur=$(gsettings get org.gnome.shell "$1" 2>/dev/null)
    grep -q "'$UUID'" <<<"$cur" || return 0
    new=$(python3 -I -c "import ast,sys; l=[x for x in ast.literal_eval(sys.argv[1]) if x!=sys.argv[2]]; print(repr(l) if l else '@as []')" "${cur#@as }" "$UUID")
    gsettings set org.gnome.shell "$1" "$new" 2>/dev/null
}

# Undo everything `setup` and the scripts created or changed for this user. The installed files are the caller's job.
cleanup() {
    "$ME" kdeconnect remove >/dev/null 2>&1                                  # GSConnect: our 3 entries (key reset if nothing else changed)
    systemctl --user disable --now phone-mic.service phone-mic-device.service 2>/dev/null
    drop_v1
    # not `gnome-extensions disable`: that puts the tile on GNOME's disabled list, which would win over a later setup
    unlist enabled-extensions
    if [ "$(pactl get-default-source 2>/dev/null)" = phone_mic ]; then       # `phone-mic default` had made Phone Mic the default input
        real=$(pactl list short sources 2>/dev/null | awk '$2 !~ /\.monitor$/ && $2 != "phone_mic" {print $2; exit}')
        [ -n "$real" ] && pactl set-default-source "$real" 2>/dev/null
    fi
    rm -f "$DONE" "$CONF_DIR/prev-default-input"; rm -rf "$RUN_DIR"
}

case "${1:-status}" in
    on)      systemctl --user start $UNITS && notify "ON — streaming starts as soon as the phone is reachable" ;;
    off)     systemctl --user stop phone-mic.service
             notify "OFF — phone microphone released (until 'phone-mic on' or next login)" ;;
    enable)  systemctl --user enable --now $UNITS >/dev/null 2>&1 && echo "autostart ON: phone mic connects automatically at every login" ;;
    disable) systemctl --user disable --now phone-mic.service >/dev/null 2>&1 && echo "autostart OFF and stopped: use 'phone-mic on' when you want it, 'phone-mic enable' to make it automatic again" ;;
    toggle)  if systemctl --user is-active -q phone-mic.service; then "$0" off; else "$0" on; fi ;;
    state)   # for scripts / the GNOME tile: off | waiting | pairing <code> | streaming
        set -- $(state_line)
        if [ "$1" = pairing ]; then echo "pairing $2"; else echo "$1"; fi ;;
    pair)    # show a QR code for the phone app; scanning it pairs at once. Also allows code pairing of another phone (5 minutes)
        systemctl --user is-active -q phone-mic.service || systemctl --user start $UNITS
        for _ in $(seq 20); do grep -q computer_id "$CONF_DIR/phones.json" 2>/dev/null && break; sleep 0.5; done
        cid=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["computer_id"])' "$CONF_DIR/phones.json" 2>/dev/null)
        [ -n "$cid" ] || { echo "phone-mic: the service does not start; see: phone-mic log"; exit 1; }
        mkdir -p "$RUN_DIR"
        secret=$(python3 -I -c 'import secrets; print(secrets.token_hex(16))')
        (umask 077; echo "$secret" > "$RUN_DIR/pair-secret"); touch "$RUN_DIR/pair"
        name=$(python3 -I -c 'import socket, urllib.parse; print(urllib.parse.quote(socket.gethostname(), safe=""))')
        hosts=$(ip -4 -o addr show up 2>/dev/null | awk '$2 !~ /^(lo|docker|br-|virbr|veth|tun|tap|wg|tailscale|zt|vboxnet|vmnet)/ {split($4, a, "/"); print a[1]}' | head -4 | paste -sd, -)
        url="phonemic://pair?v=1&c=$cid&n=$name&s=$secret&h=$hosts"
        before=$(grep -o '"key"' "$CONF_DIR/phones.json" 2>/dev/null | wc -l)
        echo "In the Phone Mic app on the phone tap the QR button and scan this (or scan it with the camera app):"
        if command -v qrencode >/dev/null; then qrencode -t ANSIUTF8 -m 2 "$url"; else echo "  $url"; echo "  (install qrencode to see a QR code)"; fi
        echo "No app on the phone yet? Run: phone-mic app"
        echo "Waiting for the phone (5 minutes; Ctrl+C to stop)..."
        shown=""
        for _ in $(seq 300); do
            now=$(grep -o '"key"' "$CONF_DIR/phones.json" 2>/dev/null | wc -l)
            if [ "$now" -gt "$before" ]; then
                sleep 1; echo "Paired: $(python3 -I -c 'import json,sys; p=json.load(open(sys.argv[1]))["phones"]; print(max(p.values(), key=lambda x: x.get("paired", 0))["name"])' "$CONF_DIR/phones.json"). It streams in a moment."
                exit 0
            fi
            set -- $(state_line)
            if [ "$1" = pairing ] && [ "$shown" != "$2" ]; then echo "$(decode "$3") asks to pair with code $2: tap Allow on the phone if it shows the same code."; shown=$2; fi
            [ -e "$RUN_DIR/pair" ] || [ "$now" -gt "$before" ] || { echo "Pairing window closed."; exit 1; }
            sleep 1
        done
        rm -f "$RUN_DIR/pair-secret" "$RUN_DIR/pair"; echo "No phone paired within 5 minutes."; exit 1 ;;
    phones)  python3 -I - "$CONF_DIR/phones.json" <<'PY'
import json, sys, time
try: d = json.load(open(sys.argv[1]))
except (OSError, ValueError): d = {}
p = d.get("phones", {})
if not p: print("no phone paired yet"); sys.exit(0)
for pid, x in p.items():
    print(f"{x['name']:30} last address {x.get('ip') or '-':15}  paired {time.strftime('%Y-%m-%d', time.localtime(x.get('paired', 0)))}  (id {pid})")
PY
        ;;
    forget)  # forget a paired phone (by name or id), or all of them
        [ -n "${2:-}" ] || { echo "usage: phone-mic forget <phone name or id> | all"; exit 2; }
        python3 -I - "$CONF_DIR/phones.json" "$2" <<'PY' || exit 1
import json, os, sys
f, what = sys.argv[1], sys.argv[2]
try: d = json.load(open(f))
except (OSError, ValueError): print("no phone paired"); sys.exit(1)
p = d.get("phones", {})
gone = [k for k, x in p.items() if what in ("all", k) or x["name"].lower() == what.lower()]
if not gone: print(f"no paired phone called {what} (see: phone-mic phones)"); sys.exit(1)
for k in gone: print(f"forgot {p.pop(k)['name']}")
tmp = f + ".tmp"
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as out: json.dump(d, out, indent=1)
os.replace(tmp, f)
PY
        systemctl --user try-restart phone-mic.service
        echo "In the Phone Mic app on the phone, also tap Forget next to this computer." ;;
    app)     app_help ;;
    default) pactl set-default-source phone_mic && echo "Phone Mic is now the default input device" ;;
    log)     journalctl --user -u phone-mic.service -u phone-mic-device.service -n "${2:-40}" --no-pager ;;
    status)
        for u in $UNITS; do printf "%-28s %s / autostart: %s\n" "$u" "$(systemctl --user is-active $u)" "$(systemctl --user is-enabled $u 2>/dev/null)"; done
        set -- $(state_line)
        case "$1" in
            off)       echo "state: off" ;;
            waiting)   echo "state: on, waiting for the phone (Phone Mic app switched on, same network)" ;;
            pairing)   echo "state: PAIRING with $(decode "$3"): tap Allow on the phone if it shows the code $2" ;;
            streaming) echo "state: streaming from $(decode "$2")" ;;
            *)         echo "state: $*" ;;
        esac
        echo "paired phones:"; "$ME" phones | sed 's/^/   /'
        echo "default input: $(pactl get-default-source)"
        paired || echo "No phone paired yet: run 'phone-mic app' to see how to get the app."
        problems ;;
    test)
        f=$(mktemp --suffix=.wav); echo "Recording 5 seconds from Phone Mic — speak now..."
        timeout 5 parecord -d phone_mic --file-format=wav "$f"
        python3 -I - "$f" <<'PY'
import sys, wave, struct
w = wave.open(sys.argv[1]); n = w.getnframes() * w.getnchannels()
d = struct.unpack('<%dh' % n, w.readframes(w.getnframes())) if n else [0]
p = max(abs(x) for x in d); print("peak level: %d / 32767  ->  %s" % (p, "OK, sound received" if p > 500 else "SILENT (phone not streaming?)"))
PY
        echo "Playing it back..."; paplay "$f"; rm -f "$f" ;;
    doctor)
        echo "phone-mic $VERSION ($ME)"; "$0" status; echo "--- last log lines:"; "$0" log 15 ;;
    kdeconnect)   # put "Phone Mic ON / OFF / TOGGLE" into the KDE Connect app on the phone (via GSConnect's Run Command)
        what="${2:-add}"
        if command -v gjs >/dev/null && [ -f "$LIB/phone-mic-gsconnect.js" ]; then
            gjs -m "$LIB/phone-mic-gsconnect.js" "$what" "$ME"; rc=$?
        else rc=2; fi
        if [ "$rc" = 2 ]; then cat <<EOF
No GSConnect found, so nothing was changed. To control the mic from the phone later:
  GNOME:      install the GSConnect extension, pair the phone, then run:  phone-mic kdeconnect
  KDE Plasma: System Settings -> KDE Connect -> your phone -> Run commands -> add:
                Phone Mic ON      $ME on
                Phone Mic OFF     $ME off
                Phone Mic TOGGLE  $ME toggle
The commands then appear in the KDE Connect app on the phone under "Run Command".
EOF
        fi
        exit $rc ;;
    setup)   # the per-user half of an installation: autostart, start now, GNOME tile, KDE Connect buttons. Safe to repeat.
             # --auto (package install/upgrade and phone-mic-setup.service at login): only if this user is not set up yet.
        uid=$(id -u); { [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ]; } || exit 0        # people only: not root, not the login screen's user
        systemctl --user show-environment >/dev/null 2>&1 || { echo "phone-mic: no systemd user session for $(id -un); run 'phone-mic setup' after logging in."; exit 1; }
        auto=1; moved=0; before=0
        { [ -f "$DONE" ] || { [ "$PACKAGED" = 1 ] && [ -e ~/.config/systemd/user/phone-mic.service ]; }; } && before=1
        # set up before and autostart is off: that was `phone-mic disable`, keep it
        [ $before = 1 ] && [ "$(systemctl --user is-enabled phone-mic.service 2>/dev/null)" = disabled ] && auto=0
        [ "$PACKAGED" = 1 ] && drop_home_copy && moved=1
        # set up by version 1 (adb + scrcpy): redo the setup once for the app-based version
        [ "${2:-}" = --auto ] && [ -f "$DONE" ] && [ "$(cut -d. -f1 "$DONE")" -ge 2 ] 2>/dev/null && [ $moved = 0 ] && exit 0
        mkdir -p "$CONF_DIR"
        [ -f "$CONF_DIR/config" ] || [ ! -f /usr/share/phone-mic/config.example ] || install -m 644 /usr/share/phone-mic/config.example "$CONF_DIR/config"
        drop_v1
        systemctl --user daemon-reload
        systemctl --user enable -q phone-mic-device.service
        systemctl --user restart phone-mic-device.service
        if [ $auto = 1 ]; then systemctl --user enable -q phone-mic.service; systemctl --user restart phone-mic.service
        else systemctl --user try-restart phone-mic.service; fi
        # Optional GNOME Quick Settings tile (only if GNOME Shell is present)
        tile=""
        if command -v gnome-shell >/dev/null; then
            # `gnome-extensions enable` only works once the shell has loaded the extension (at login). Writing the
            # setting directly makes it enabled at the next login too, so no visit to Extension Manager is needed.
            unlist disabled-extensions          # disabled by hand or by an older uninstall: that list wins, take it off
            cur=$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || echo "@as []")
            if ! grep -q "'$UUID'" <<<"$cur"; then
                if [ "$cur" = "@as []" ] || [ "$cur" = "[]" ]; then new="['$UUID']"; else new="${cur%]}, '$UUID']"; fi
                gsettings set org.gnome.shell enabled-extensions "$new" 2>/dev/null
            fi
            # still "not there" for the running shell: it only looks for new extensions when it starts
            gnome-extensions enable $UUID 2>/dev/null && [ $moved = 0 ] || tile=" Log out and back in once to see the Phone Mic tile in Quick Settings."
        fi
        # Optional: "Phone Mic ON/OFF/TOGGLE" buttons in the KDE Connect app on the phone (needs GSConnect + a paired phone).
        # Harmless if GSConnect is missing; can be run any time later with:  phone-mic kdeconnect
        "$ME" kdeconnect add >/dev/null 2>&1
        echo "$VERSION" > "$DONE"
        echo "phone-mic: set up for $(id -un). Check with: phone-mic status.$tile"
        if ! paired; then
            app_help
            command -v notify-send >/dev/null && notify-send -i audio-input-microphone "Phone Mic" \
                "Install the Phone Mic app on the phone: $APP_URL — or run 'phone-mic app' for a QR code."
        fi
        problems ;;
    uninstall)   # undo everything the installation and the scripts ever created or changed
        if [ "${2:-}" = --from-package ]; then cleanup; exit 0; fi      # apt is removing the package: this user's part, config kept
        cleanup
        rm -rf "$CONF_DIR"                                                       # config, paired phones, saved previous input
        echo "Removed: services, launcher, GNOME tile, KDE Connect buttons, $CONF_DIR (paired phones), virtual mic."
        echo "On the phone: uninstall the Phone Mic app like any other app. Not touched: old lines in the system journal."
        if [ "$PACKAGED" = 1 ]; then
            echo "Now the package itself and its apt source (asks for your password):  sudo apt-get purge phone-mic"
            exec sudo apt-get purge -y phone-mic
        fi
        rm -f ~/.config/systemd/user/phone-mic.service ~/.config/systemd/user/phone-mic-device.service
        systemctl --user daemon-reload
        rm -rf ~/.local/share/gnome-shell/extensions/$UUID
        rm -f ~/.local/share/applications/phone-mic-toggle.desktop
        rm -f ~/.local/bin/phone-mic-daemon ~/.local/bin/phone-mic-gsconnect.js
        rm -f ~/.local/bin/phone-mic ;;
    version) echo "phone-mic $VERSION" ;;
    *) echo "usage: phone-mic on|off|toggle|enable|disable|state|status|pair|phones|forget <phone>|app|log|test|default|doctor|kdeconnect [add|remove]|setup|uninstall|version"; exit 2 ;;
esac
